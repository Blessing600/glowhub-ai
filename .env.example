# GlowHub AI — frontend prototype configuration.
# Copy to .env.local for local overrides. Every value here is public (NEXT_PUBLIC_*)
# and is shipped to the browser: never put secrets, API keys or real customer data here.

# local | staging | production
NEXT_PUBLIC_DEPLOY_ENV=local
# Canonical URL used for metadata, sitemap and Open Graph. No domain is hardcoded.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Future backend (NestJS) base URL. Unused while mock services are active.
NEXT_PUBLIC_API_URL=
# Search indexing is allowed only when DEPLOY_ENV=production AND this is true.
# Staging is always noindex. robots.txt is not access control — restrict staging separately.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Feature flags
NEXT_PUBLIC_DEMO_MODE=true
# Local-only camera preview in Glow Scan. Photos are never uploaded, stored or analysed.
NEXT_PUBLIC_CAMERA_PREVIEW_ENABLED=true
# Locked off in the prototype: setting any of these to true stops the app with an error.
NEXT_PUBLIC_LIVE_SCAN_ENABLED=false
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Proposed payment service provider. Integration contracts only; no live calls.
NEXT_PUBLIC_PAYMENT_PROVIDER=paystack

# Legal and contact details. Leave blank until confirmed; pages show "to be confirmed".
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_REGISTRATION_NUMBER=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_LEGAL_VERSION=0.1-draft
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=
